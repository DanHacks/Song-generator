# Copy to backend/.env and fill in. Never commit backend/.env.

# M-Pesa Daraja (sandbox by default; use production for live money)
# Get sandbox credentials free at https://developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
# Public HTTPS URL reachable from Safaricom's servers, e.g.
# https://your-tunnel.trycloudflare.com (no trailing slash)
MPESA_CALLBACK_BASE=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public app URL for Stripe redirects
APP_URL=http://localhost:5173

# Auth secret (optional; a persistent random one is generated otherwise)
AUTH_SECRET=
